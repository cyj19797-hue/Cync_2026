    "locker.accountInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dudu Bank 123456-01-987654 (Holder: CS Student Council)\nPlease deposit the locker fee of 10,000 KRW.\nUse \"Student ID + Name\" as the depositor name.\nApproval takes up to 2–3 days after confirmation."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "듀듀은행 123456-01-987654 (예금주: 컴퓨터공학과 학생회)\n사물함 이용료 10,000원을 입금해 주세요.\n입금자명은 \"학번+이름\"으로 입력해 주세요.\n확인 후 승인까지 최대 2~3일 소요됩니다."
          }
        }
      }
    },
